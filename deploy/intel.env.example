# Opcion recomendada
GEMINI_API_KEY=reemplazar
GEMINI_MODEL=gemini-3.1-flash-lite
UFC_INTEL_TIMEZONE=America/Santiago
# Requests por minuto contra Gemini. Todas las llamadas (cartelera e inteligencia por
# peleador) hacen cola contra este numero. Default 10, que es el free tier; subirlo por
# arriba de lo que aguanta la cuenta devuelve los 429.
# UFC_IA_RPM=15
# Opcional, requiere un proyecto con facturacion: busqueda web con citas por peleador.
# UFC_INTEL_GROUNDING=1

# Opcional: habilita las cuentas X oficiales resueltas o configuradas.
# X_BEARER_TOKEN=reemplazar

# Bot de Telegram (ufc-tipster.service). El token lo da @BotFather.
# TELEGRAM_CHAT_IDS es una allowlist separada por comas: el bot ignora en silencio a
# cualquier otro. Sin ella no le habla a nadie, y es a proposito — publica picks antes de
# que se peleen, tu ROI y tu banca. Para saber tu id, escribile al bot y mira el log.
TELEGRAM_BOT_TOKEN=reemplazar
TELEGRAM_CHAT_IDS=reemplazar
# Rama de la que salen los picks. Default: ufc-fight-predictor
# TIPSTER_RAMA=ufc-fight-predictor

# Alternativa OpenAI-compatible (NVIDIA, DeepSeek, Groq u Ollama)
# UFC_INTEL_BASE_URL=https://api.deepseek.com
# UFC_INTEL_API_KEY=reemplazar
# UFC_INTEL_MODEL=deepseek-v4-flash
